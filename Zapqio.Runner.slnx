<Solution>
  <!--
    The "protocol" submodule's files are deliberately not listed here: .slnx has no globs, so the
    list went stale with every new fixture. Zapqio.Runner.Protocol.Tests shows the whole directory
    (its "protocol" folder) through a glob in the csproj.
  -->
  <Project Path="Zapqio.Runner.Protocol/Zapqio.Runner.Protocol.csproj" />
  <Project Path="Zapqio.Runner.Protocol.Tests/Zapqio.Runner.Protocol.Tests.csproj" />
  <Project Path="Zapqio.Runner.Module.Core/Zapqio.Runner.Module.Core.csproj" />
  <Project Path="Zapqio.Runner/Zapqio.Runner.csproj" />
  <Project Path="Zapqio.Runner.Tests/Zapqio.Runner.Tests.csproj" />
  <Folder Name="/Zapqio.Runner.Tests.Modules/">
    <Project Path="Zapqio.Runner.Tests.Modules/TestModule.Shared/TestModule.Shared.csproj" />
    <Project Path="Zapqio.Runner.Tests.Modules/TestModule.Shared.Extra/TestModule.Shared.Extra.csproj" />
    <Project Path="Zapqio.Runner.Tests.Modules/TestModule.Consumer/TestModule.Consumer.csproj" />
  </Folder>
</Solution>

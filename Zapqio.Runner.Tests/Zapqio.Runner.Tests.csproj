<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Host runnera i (przez niego) kontrakt modułów. Testy protokołu mają osobny projekt. -->
  <ItemGroup>
    <ProjectReference Include="..\Zapqio.Runner\Zapqio.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Moduły testowe dla MethodsProviderTests: budowane razem z testami, ale NIE referencjonowane -
       runner ma je załadować z zipów własnym mechanizmem, więc ich DLL nie mogą leżeć obok binarki
       testów (host rozwiązałby je sam). Lądują w TestModules\ pod katalogiem wyjściowym. -->
  <ItemGroup>
    <ProjectReference Include="..\Zapqio.Runner.Tests.Modules\TestModule.Shared\TestModule.Shared.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleDll" />
    <ProjectReference Include="..\Zapqio.Runner.Tests.Modules\TestModule.Shared.Extra\TestModule.Shared.Extra.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleDll" />
    <ProjectReference Include="..\Zapqio.Runner.Tests.Modules\TestModule.Consumer\TestModule.Consumer.csproj" ReferenceOutputAssembly="false" OutputItemType="TestModuleDll" />
  </ItemGroup>

  <Target Name="CopyTestModules" AfterTargets="Build">
    <Copy SourceFiles="@(TestModuleDll)" DestinationFolder="$(OutDir)TestModules" SkipUnchangedFiles="true" />
  </Target>

</Project>
